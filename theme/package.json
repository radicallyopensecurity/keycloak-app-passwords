{
    "name": "keycloak-app-passwords",
    "version": "1.2.0",
    "description": "Keycloak App Passwords Theme",
    "repository": {
        "type": "git",
        "url": "git://github.com/radicallyopensecurity/keycloak-app-passwords.git"
    },
    "type": "module",
    "scripts": {
        "start": "npx keycloakify start-keycloak --keycloak-version 26",
        "postinstall": "keycloakify sync-extensions",
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme:dev": "NODE_ENV=development npm run build && keycloakify build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write"
    },
    "license": "LGPL-3.0",
    "keywords": [
        "keycloak",
        "extension",
        "keycloak-extension"
    ],
    "dependencies": {
        "@keycloak/keycloak-admin-client": "26.7.0",
        "@keycloakify/keycloak-account-ui": "~260700.0.3",
        "@keycloakify/keycloak-ui-shared": "~260700.0.2",
        "@patternfly/patternfly": "^5.4.2",
        "@patternfly/react-core": "^5.4.14",
        "@patternfly/react-icons": "^5.4.2",
        "@patternfly/react-styles": "^5.4.1",
        "@patternfly/react-table": "^5.4.16",
        "i18next": "^25.7.3",
        "i18next-fetch-backend": "^7.0.0",
        "keycloak-js": "^26.2.0",
        "keycloakify": "11.16.0",
        "lodash-es": "^4.18.1",
        "oidc-spa": "~10.2.10",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-hook-form": "^7.70.0",
        "react-i18next": "^16.5.1",
        "react-router-dom": "^6.30.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@storybook/react": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "26.6.5",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-storybook": "^10.6.1",
        "globals": "^17.13.0",
        "prettier": "3.9.10",
        "storybook": "^10.6.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    }
}
